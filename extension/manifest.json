{
  "manifest_version": 3,
  "name": "YT Local Downloader",
  "version": "1.1",
  "description": "Adds a download button next to Subscribe. Uses a local helper (yt-dlp).",
  "permissions": ["cookies"],
  "host_permissions": [
    "http://127.0.0.1:9477/*",
    "https://*.youtube.com/*",
    "https://*.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
